resource "workload-type" "debian-nutanix-13" {
	code             = "debian-nutanix-13"
	shortName        = "debian"
	name             = "Debian 13"
	ports = [22]
	containerVersion = "13"
	repositoryImage  = ""
	entryPoint       = ""
	serverType       = "vm"
	statTypeCode     = "vm"
	logTypeCode      = "debian"
	showServerLogs   = true
	checkTypeCode    = "containerCheck"
	mountPoint       = "/morpheus"
	virtualImage     = null
	osType = {
		code  = "debian.13.64"
		owner = null
	}
	containerPorts = [
		{
			code = "debian.22"
		}
	]
	actions = [
		{
			code = "generic-remove-node"
		}
	]
	provisionType = "nutanix"
	backupType    = "nutanixSnapshot"
}

resource "workload-type-set" "debian-nutanix-13-set" {
	code           = "debian-nutanix-13-set"
	workloadType   = workload-type.debian-nutanix-13
	priorityOrder  = 0
	dynamicCount   = true
	containerCount = 1
}

resource "instance-type-layout" "debian-nutanix-13" {
	code                     = "debian-nutanix-13"
	name                     = "Nutanix VM"
	sortOrder                = 13
	serverType               = "vm"
	supportsConvertToManaged = true
	instanceVersion          = "13"
	description              = "This will provision a single process with no redundancy"
	instanceType             = "debian"
	serverCount              = 1
	portCount                = 1
	enabled                  = true
	creatable                = true
	containers = [
		workload-type-set.debian-nutanix-13-set
	]
	actions = [
		{
			code = "generic-add-node"
		}
	]
	provisionType = {
		code = "nutanix"
	}
}

resource "scale-action" "debian-nutanix-13" {
	code      = "debian-nutanix-13"
	scaleType = "action"
	layout    = instance-type-layout.debian-nutanix-13
	upAction = {
		code = "generic-add-node"
	}
	downAction = {
		code = "generic-remove-node"
	}
}

resource "os-type-image" "nutanix-morpheus-debian-13" {
	code          = "nutanix-morpheus-debian-13"
	provisionType = "nutanix"
	virtualImage = {
		code = "kvm.image.morpheus.debian.13.20260120"
	}
	osType = {
		code  = "debian.13.64"
		owner = null
	}
}
