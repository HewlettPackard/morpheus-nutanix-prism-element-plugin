resource "workload-type" "rocky-nutanix-10" {
	code             = "rocky-nutanix-10"
	shortName        = "rocky"
	name             = "Rocky 10"
	ports = []
	containerVersion = "10"
	repositoryImage  = ""
	entryPoint       = ""
	serverType       = "vm"
	statTypeCode     = "vm"
	logTypeCode      = "vm"
	showServerLogs   = true
	checkTypeCode    = null
	category         = "rocky"
	osType           = "rocky.10.64"
	virtualImage     = null
	provisionType    = "nutanix"
	backupType       = "nutanixSnapshot"
	containerPorts = []
	actions = [
		{
			code = "generic-remove-node"
		}
	]
	commEnabled = true
	commType    = "SSH"
	commPort    = 22
}

resource "workload-type-set" "rocky-nutanix-10-set" {
	code           = "rocky-nutanix-10-set"
	category       = "rocky"
	workloadType   = workload-type.rocky-nutanix-10
	priorityOrder  = 0
	dynamicCount   = true
	containerCount = 1
}

resource "instance-type-layout" "rocky-nutanix-10" {
	code                     = "rocky-nutanix-10"
	name                     = "Nutanix VM"
	sortOrder                = 99
	description              = "This will provision a single master vm in Nutanix"
	instanceType             = "rocky"
	instanceVersion          = "10"
	serverCount              = 1
	portCount                = 1
	memoryRequirement = 1024 * 1024 * 1024 // 1gb
	serverType               = "vm"
	supportsConvertToManaged = true
	enabled                  = true
	creatable                = true
	hasAutoScale             = true
	containers = [
		workload-type-set.rocky-nutanix-10-set
	]
	actions = [
		{
			code = "generic-add-node"
		}
	]
	provisionType = "nutanix"
}

resource "scale-action" "rocky-nutanix-10" {
	code      = "rocky-nutanix-10"
	scaleType = "action"
	layout    = instance-type-layout.rocky-nutanix-10
	upAction = {
		code = "generic-add-node"
	}
	downAction = {
		code = "generic-remove-node"
	}
}

resource "os-type-image" "nutanix-morpheus-rocky-10" {
	code          = "nutanix-morpheus-rocky-10"
	provisionType = "nutanix"
	virtualImage = {
		code = "kvm.image.morpheus.rocky.10.20260126"
	}
	osType = {
		code  = "rocky.10.64"
		owner = null
	}
}
